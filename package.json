{
  "name": "applykit",
  "description": "A privacy-first browser extension that helps you complete repetitive job applications.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:dock": "APPLYKIT_CONCEPT=command-dock wxt",
    "dev:inspector": "APPLYKIT_CONCEPT=field-inspector wxt",
    "build": "pnpm build:dock && pnpm build:inspector",
    "build:dock": "APPLYKIT_CONCEPT=command-dock wxt build",
    "build:inspector": "APPLYKIT_CONCEPT=field-inspector wxt build",
    "build:safari": "APPLYKIT_CONCEPT=command-dock wxt build -b safari --mv3",
    "zip": "APPLYKIT_CONCEPT=command-dock wxt zip",
    "fixtures": "node scripts/serve-fixtures.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "capture": "pnpm build && APPLYKIT_CAPTURE=1 playwright test e2e/capture.spec.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:e2e",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "lucide-react": "1.53.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "wxt": "0.21.4"
  },
  "license": "MIT",
  "author": "Hamid Aziz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HamidZ11/applykit.git"
  },
  "homepage": "https://github.com/HamidZ11/applykit",
  "bugs": {
    "url": "https://github.com/HamidZ11/applykit/issues"
  }
}
